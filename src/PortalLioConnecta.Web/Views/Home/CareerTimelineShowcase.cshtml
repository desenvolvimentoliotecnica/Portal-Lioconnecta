@{
    ViewData["Title"] = "Timeline da Carreira";
}

<div class="showcase-shell">
    <div class="showcase-header">
        <div>
            <p class="showcase-eyebrow">Showcase</p>
            <h1>Timeline da Carreira</h1>
            <p class="showcase-lead">Componente mocado para validar o padrão visual do portal antes da integração com os dados reais do TOTVS RM.</p>
        </div>
        <label class="showcase-toggle" for="toggle-test-grid-dashed">
            <input type="checkbox" id="toggle-test-grid-dashed" />
            <span>Exibir tracejado em todas as divs</span>
        </label>
    </div>

    @await Component.InvokeAsync("CareerTimeline")
</div>
