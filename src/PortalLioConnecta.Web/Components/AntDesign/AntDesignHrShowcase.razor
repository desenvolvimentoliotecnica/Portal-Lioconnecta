@namespace PortalLioConnecta.Web.Components.AntDesign

<div class="ant-rh-showcase">
    <Breadcrumb Class="ant-rh-showcase__breadcrumb">
        <BreadcrumbItem Href="/">Portal RH</BreadcrumbItem>
        <BreadcrumbItem Href="/Home/CareerTimelineShowcase">Showcases</BreadcrumbItem>
        <BreadcrumbItem>Ant Design Blazor</BreadcrumbItem>
    </Breadcrumb>

    <Alert Message="@Data.Title"
           Description="@Data.Subtitle"
           ShowIcon="true"
           Banner="true" />

    <div class="ant-rh-showcase__filters">
        @foreach (var filter in Data.Filters)
        {
            <Tag Color="@filter.Color">@filter.Label</Tag>
        }
    </div>

    <Row Gutter="16" Class="ant-rh-showcase__hero-grid">
        <AntDesign.Col Span="16">
            <Card Class="ant-rh-showcase__card ant-rh-showcase__hero-card">
                <div class="ant-rh-showcase__eyebrow">Portal de recrutamento e selecao</div>
                <h2>Showcase hibrida para validar componentes, navegacao e padroes visuais antes da integracao com TOTVS RM.</h2>
                <p>
                    A proposta aqui e concentrar indicadores, pipeline, candidatos, vagas, aprovacoes e estados de feedback
                    em uma unica pagina, simulando um painel de uso real para RH.
                </p>

                <div class="ant-rh-showcase__hero-tags">
                    <Tag Color="@("blue")">MVC .NET 8</Tag>
                    <Tag Color="@("purple")">Blazor Server</Tag>
                    <Tag Color="@("green")">Mock service</Tag>
                    <Tag Color="@("gold")">Preparado para RM</Tag>
                </div>
            </Card>
        </AntDesign.Col>

        <AntDesign.Col Span="8">
            <Card Class="ant-rh-showcase__card ant-rh-showcase__hero-side-card">
                <strong>O que esta sendo validado</strong>
                <div class="ant-rh-showcase__side-list">
                    <div class="ant-rh-showcase__side-item">
                        <span>Experiencia visual</span>
                        <Tag Color="@("blue")">Layouts</Tag>
                    </div>
                    <div class="ant-rh-showcase__side-item">
                        <span>Componentes prontos</span>
                        <Tag Color="@("green")">Ant Design</Tag>
                    </div>
                    <div class="ant-rh-showcase__side-item">
                        <span>Origem dos dados</span>
                        <Tag Color="@("cyan")">Controller + Service</Tag>
                    </div>
                    <div class="ant-rh-showcase__side-item">
                        <span>Proximo passo</span>
                        <Tag Color="@("gold")">Integracao real</Tag>
                    </div>
                </div>
            </Card>
        </AntDesign.Col>
    </Row>

    <Row Gutter="16" Class="ant-rh-showcase__metrics">
        @foreach (var metric in Data.Metrics)
        {
            <AntDesign.Col Span="6">
                <Card Class="ant-rh-showcase__metric-card">
                    <Statistic Title="@metric.Title" Value="@metric.Value" />
                    <Tag Color="@metric.AccentColor">@metric.Title</Tag>
                </Card>
            </AntDesign.Col>
        }
    </Row>

    <Row Gutter="16" Class="ant-rh-showcase__summary-grid">
        @foreach (var summary in Data.SummaryCards)
        {
            <AntDesign.Col Span="8">
                <Card Class="ant-rh-showcase__card ant-rh-showcase__summary-card">
                    <div class="ant-rh-showcase__summary-header">
                        <strong>@summary.Title</strong>
                        <Tag Color="@summary.TagColor">@summary.TagText</Tag>
                    </div>
                    <p>@summary.Description</p>
                </Card>
            </AntDesign.Col>
        }
    </Row>

    <Tabs DefaultActiveKey="dashboard" Class="ant-rh-showcase__tabs">
        <TabPane Key="dashboard" Tab="Dashboard">
            <Row Gutter="16">
                <AntDesign.Col Span="24">
                    <Card Title="Etapas do recrutamento" Class="ant-rh-showcase__card">
                        <Steps Current="2">
                            <Step Title="Abertura" Description="Solicitacao aprovada" />
                            <Step Title="Triagem" Description="Shortlist em andamento" />
                            <Step Title="Entrevistas" Description="Gestores envolvidos" />
                            <Step Title="Oferta" Description="Negociacao final" />
                        </Steps>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="14">
                    <Card Title="Pipeline seletivo" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__stage-list">
                            @foreach (var stage in Data.Stages)
                            {
                                <div class="ant-rh-showcase__stage-item">
                                    <div class="ant-rh-showcase__stage-header">
                                        <strong>@stage.Title</strong>
                                        <span>@stage.Subtitle</span>
                                    </div>
                                    <Progress Percent="@stage.Percent" />
                                </div>
                            }
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="10">
                    <Card Title="Configuracao mockada" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__config-list">
                            <div class="ant-rh-showcase__config-item">
                                <span>Frontend</span>
                                <strong>MVC + componente Blazor</strong>
                            </div>
                            <div class="ant-rh-showcase__config-item">
                                <span>Biblioteca</span>
                                <strong>Ant Design Blazor</strong>
                            </div>
                            <div class="ant-rh-showcase__config-item">
                                <span>Origem dos dados</span>
                                <strong>Service mockada</strong>
                            </div>
                            <div class="ant-rh-showcase__config-item">
                                <span>Integracao futura</span>
                                <strong>TOTVS RM</strong>
                            </div>
                        </div>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="8">
                    <Card Title="Riscos operacionais" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__tag-wall">
                            <Tag Color="@("red")">2 vagas acima do SLA</Tag>
                            <Tag Color="@("gold")">1 proposta aguardando aceite</Tag>
                            <Tag Color="@("blue")">3 gestores com agenda parcial</Tag>
                            <Tag Color="@("purple")">Integracao RM pendente</Tag>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Saude do funil" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__mini-progress-list">
                            <div>
                                <span>Candidatos aderentes</span>
                                <Progress Percent="81" />
                            </div>
                            <div>
                                <span>Gestores respondendo no prazo</span>
                                <Progress Percent="68" />
                            </div>
                            <div>
                                <span>Checklist de admissao pronto</span>
                                <Progress Percent="54" />
                            </div>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Feedback rapido" Class="ant-rh-showcase__card">
                        <Alert Message="Fluxo estavel"
                               Description="A esteira principal esta pronta para virar referencia visual do portal."
                               ShowIcon="true" />
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <Card Title="Atividades recentes" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__activity-list">
                            @foreach (var activity in Data.Activities)
                            {
                                <div class="ant-rh-showcase__activity-item">
                                    <div>
                                        <strong>@activity.Title</strong>
                                        <p>@activity.Description</p>
                                    </div>
                                    <Tag Color="@("blue")">@activity.TimeLabel</Tag>
                                </div>
                            }
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12">
                    <Card Class="ant-rh-showcase__card">
                        <Result Title="Pipeline operacional saudavel"
                                SubTitle="Os mocks combinam indicadores, etapas, timeline, candidatos, vagas, alertas, feedbacks e estados vazios." />
                    </Card>
                </AntDesign.Col>
            </Row>
        </TabPane>

        <TabPane Key="candidatos" Tab="Candidatos">
            <Row Gutter="16">
                @foreach (var candidate in Data.Candidates)
                {
                    <AntDesign.Col Span="12">
                        <Card Class="ant-rh-showcase__card ant-rh-showcase__candidate-card">
                            <div class="ant-rh-showcase__candidate-top">
                                <Avatar Style="background-color:#1677ff;vertical-align:middle;">
                                    @candidate.Name[..1]
                                </Avatar>
                                <div>
                                    <h4>@candidate.Name</h4>
                                    <p>@candidate.Position</p>
                                </div>
                            </div>

                            <div class="ant-rh-showcase__candidate-meta">
                                <Tag Color="@candidate.TagColor">@candidate.Stage</Tag>
                                <Tag Color="@("processing")">@($"Score {candidate.Score}")</Tag>
                            </div>

                            <Divider />

                            <Progress Percent="@candidate.Score" />
                        </Card>
                    </AntDesign.Col>
                }
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="10">
                    <Card Title="Segmentacao mockada" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__tag-wall">
                            <Tag Color="@("blue")">Tech</Tag>
                            <Tag Color="@("green")">RH</Tag>
                            <Tag Color="@("purple")">Lideranca</Tag>
                            <Tag Color="@("gold")">Banco interno</Tag>
                            <Tag Color="@("cyan")">Indicacao</Tag>
                            <Tag Color="@("red")">Urgente</Tag>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="14">
                    <Card Title="Observacao de UX" Class="ant-rh-showcase__card">
                        <Alert Message="Boa area para explorar filtros mais ricos"
                               Description="Aqui podemos evoluir depois para busca, selecao multipla, drawers, modais e tabelas com paginacao."
                               ShowIcon="true" />
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="24">
                    <Card Title="Banco reserva" Class="ant-rh-showcase__card">
                        <Empty>@("Nenhum candidato em banco reserva para os filtros selecionados.")</Empty>
                    </Card>
                </AntDesign.Col>
            </Row>
        </TabPane>

        <TabPane Key="vagas" Tab="Vagas">
            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <Card Title="Vagas abertas" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__vacancy-list">
                            @foreach (var vacancy in Data.Vacancies)
                            {
                                <div class="ant-rh-showcase__vacancy-item">
                                    <div>
                                        <strong>@vacancy.Title</strong>
                                        <p>@vacancy.Department · @vacancy.HiringManager</p>
                                    </div>
                                    <Tag Color="@vacancy.StatusColor">@vacancy.Status</Tag>
                                </div>
                            }
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12">
                    <Card Title="Linha do tempo" Class="ant-rh-showcase__card">
                        <Timeline>
                            @foreach (var timelineEvent in Data.TimelineEvents)
                            {
                                <TimelineItem Color="@timelineEvent.Color">
                                    <strong>@timelineEvent.DateLabel</strong>
                                    <div>@timelineEvent.Description</div>
                                </TimelineItem>
                            }
                        </Timeline>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="8">
                    <Card Title="Distribuicao por area" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__mini-progress-list">
                            <div>
                                <span>Tecnologia</span>
                                <Progress Percent="63" />
                            </div>
                            <div>
                                <span>RH</span>
                                <Progress Percent="24" />
                            </div>
                            <div>
                                <span>Departamento Pessoal</span>
                                <Progress Percent="13" />
                            </div>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Criterios ativos" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__tag-wall">
                            <Tag Color="@("green")">Remoto parcial</Tag>
                            <Tag Color="@("blue")">CLT</Tag>
                            <Tag Color="@("purple")">Nivel pleno/senior</Tag>
                            <Tag Color="@("gold")">Admissao imediata</Tag>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Estado do painel" Class="ant-rh-showcase__card">
                        <Result Title="Mapa de vagas centralizado"
                                SubTitle="Boa area para futura tabela com ordenacao, filtros e detalhamento em drawer." />
                    </Card>
                </AntDesign.Col>
            </Row>
        </TabPane>

        <TabPane Key="operacao" Tab="Operacao">
            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <Card Title="Aprovacoes pendentes" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__approval-list">
                            @foreach (var approval in Data.Approvals)
                            {
                                <div class="ant-rh-showcase__approval-item">
                                    <div>
                                        <strong>@approval.RequestTitle</strong>
                                        <p>@approval.Owner</p>
                                    </div>
                                    <div class="ant-rh-showcase__approval-meta">
                                        <Tag Color="@approval.PriorityColor">@approval.Priority</Tag>
                                        <Tag Color="@("blue")">@approval.Eta</Tag>
                                    </div>
                                </div>
                            }
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12">
                    <Card Title="Checkpoints de integracao" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__checkpoint-list">
                            @foreach (var checkpoint in Data.IntegrationCheckpoints)
                            {
                                <div class="ant-rh-showcase__checkpoint-item">
                                    <div>
                                        <strong>@checkpoint.Title</strong>
                                        <p>@checkpoint.Detail</p>
                                    </div>
                                    <Tag Color="@(checkpoint.Done ? "green" : "gold")">@(checkpoint.Done ? "Concluido" : "Pendente")</Tag>
                                </div>
                            }
                        </div>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="8">
                    <Card Title="Alertas operacionais" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__stack">
                            <Alert Message="Atencao ao SLA"
                                   Description="Triagem tecnica acima do ideal em 2 vagas."
                                   ShowIcon="true" />
                            <Alert Message="Integracao parcial"
                                   Description="Carga salarial do RM segue mockada."
                                   ShowIcon="true" />
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Proximas liberacoes" Class="ant-rh-showcase__card">
                        <Timeline>
                            <TimelineItem Color="@("green")">Concluir servico de vagas</TimelineItem>
                            <TimelineItem Color="@("blue")">Adicionar autenticacao e perfis</TimelineItem>
                            <TimelineItem Color="@("gold")">Conectar DTOs ao RM</TimelineItem>
                            <TimelineItem Color="@("red")">Validar logs e auditoria</TimelineItem>
                        </Timeline>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Backlog visual" Class="ant-rh-showcase__card">
                        <Empty>@("Espaco reservado para modais, drawers, upload e fluxos de confirmacao.")</Empty>
                    </Card>
                </AntDesign.Col>
            </Row>
        </TabPane>

        <TabPane Key="componentes" Tab="Componentes">
            <Row Gutter="16">
                <AntDesign.Col Span="8">
                    <Card Title="Tags e estados" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__tag-wall">
                            <Tag Color="@("blue")">Em triagem</Tag>
                            <Tag Color="@("green")">Aprovado</Tag>
                            <Tag Color="@("red")">Critico</Tag>
                            <Tag Color="@("gold")">Aguardando retorno</Tag>
                            <Tag Color="@("purple")">Tecnologia</Tag>
                            <Tag Color="@("cyan")">Departamento Pessoal</Tag>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Avatares" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__avatar-row">
                            <Avatar Style="background-color:#1677ff;">M</Avatar>
                            <Avatar Style="background-color:#52c41a;">R</Avatar>
                            <Avatar Style="background-color:#722ed1;">C</Avatar>
                            <Avatar Style="background-color:#fa8c16;">L</Avatar>
                            <Avatar Style="background-color:#eb2f96;">P</Avatar>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Alertas rapidos" Class="ant-rh-showcase__card">
                        <div class="ant-rh-showcase__stack">
                            <Alert Message="SLA em atencao"
                                   Description="Duas vagas estao acima do tempo medio esperado."
                                   ShowIcon="true" />
                            <Alert Message="Dependencia externa"
                                   Description="Integracao real com RM ainda nao foi conectada."
                                   ShowIcon="true" />
                        </div>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="8">
                    <Card Title="Feedback de sucesso" Class="ant-rh-showcase__card">
                        <Result Title="Composicao validada"
                                SubTitle="A pagina ja demonstra bem o potencial da biblioteca para telas internas." />
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Feedback informativo" Class="ant-rh-showcase__card">
                        <Result Title="Proxima evolucao"
                                SubTitle="Podemos acrescentar tabelas, filtros avancados, modais e formularios em seguida." />
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="8">
                    <Card Title="Estado vazio" Class="ant-rh-showcase__card">
                        <Empty>@("Sem registros adicionais para esta demonstracao.")</Empty>
                    </Card>
                </AntDesign.Col>
            </Row>
        </TabPane>
    </Tabs>
</div>

@code {
    [Parameter, EditorRequired]
    public AntDesignHrShowcaseViewModel Data { get; set; } = default!;
}
